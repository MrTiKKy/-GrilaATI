# Neon PostgreSQL connection string
# Dashboard Neon → Project → Connection details → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Parolă / PIN de secție (login)
APP_PASSWORD="schimba-parola-sectie"

# Secret pentru cookie sesiune (min. 16 caractere; generează: openssl rand -hex 32)
SESSION_SECRET="schimba-secret-sesiune-min-16-chars"
